# Portfolio API (Render backend URL)
BLOG_API_URL=https://your-backend.onrender.com

# Preferred: API key for automated imports (set same value on Render as BLOG_IMPORT_API_KEY)
BLOG_IMPORT_API_KEY=your-secret-import-key

# Fallback: admin login credentials
BLOG_ADMIN_EMAIL=admin@example.com
BLOG_ADMIN_PASSWORD=your-password

# Optional: for import script output links
FRONTEND_URL=https://nsp-portfolio-frontend.vercel.app
